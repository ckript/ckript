PORT=5001
MONGO_URI=mongodb+srv://username:passward@cluster0.x9mv4pb.mongodb.net/scriptbridge
JWT_SECRET=your_jwt_secret_key_here_change_in_production
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://ckript.com,https://www.ckript.com,http://ckript.com,http://www.ckript.com
OTP_EXPIRY_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS= 2
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ── Recurring plans (Razorpay Subscriptions) ─────────────────────────────────
# FIP and writer Silver/Gold plans are sold as Razorpay Subscriptions that renew each month/year
# until the member cancels. Renewals happen with nobody on the site, so they arrive by WEBHOOK:
#   1. Razorpay Dashboard → Subscriptions: make sure the product is activated on the account.
#   2. Razorpay Dashboard → Settings → Webhooks → Add: URL = <backend>/api/webhooks/razorpay
#      (e.g. https://server-sooty-rho.vercel.app/api/webhooks/razorpay), choose a secret, and tick
#      every subscription.* event (authenticated, activated, charged, pending, halted, cancelled,
#      completed, updated, paused, resumed).
#   3. Put that secret here. It is NOT the key secret above.
# Without it every delivery is refused with 503 (Razorpay retries), and renewals only land when the
# member next loads their account (the server re-syncs from Razorpay as a fallback).
RAZORPAY_WEBHOOK_SECRET=
# Set to false ONLY if Subscriptions is not activated on the Razorpay account yet: plans then keep
# selling as one-time purchases (30/365 days, no renewal) instead of failing at checkout.
PLAN_RECURRING_BILLING=true
# Also tick payment.captured, order.paid and refund.processed on the same webhook: captures feed the
# finance reconciliation, and refunds made from the Razorpay dashboard get their credit notes.

# ── Taxes (18%, shown to users only as "Taxes") ──────────────────────────────
# See GST_BILLING_PROMPT.md and docs/TAXES.md. Listed prices stay pre-tax; checkout adds 18% on the
# full amount, for buyers in India and abroad.
# Off by default: with it off, checkout behaves exactly as it did before taxes.
GST_ENABLED=false
# When charging was switched on (ISO date-time, informational).
GST_CHARGE_FROM=
# The GST registration date. Payments before it are never taxable; payments from it until GST_ENABLED
# was switched on are back-filled (node scripts/gstGapReport.js). Default 2026-10-04T00:00:00+05:30.
TAX_LIABILITY_FROM=2026-10-04T00:00:00+05:30
# A muted "+ taxes" next to listed prices (founder: off).
SHOW_PLUS_TAXES_HINT=false
# Printed on tax invoices only. Defaults are the registration certificate's values.
COMPANY_GSTIN=07AAOCC0556A1ZZ
COMPANY_GST_STATE_CODE=07
COMPANY_REGISTERED_ADDRESS=
GOOGLE_AI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# Google Calendar OAuth (producer meeting scheduling). Uses the same OAuth client as sign-in above,
# but the classic auth-code flow needs the client SECRET and a registered redirect URI. In Google Cloud
# Console: enable the Calendar API, add scope https://www.googleapis.com/auth/calendar.events, and add
# GOOGLE_CALENDAR_REDIRECT_URI (below) as an Authorized redirect URI on the OAuth client — VERBATIM.
# Register BOTH of these on the OAuth client so dev and prod both work:
#   http://localhost:5002/api/google-calendar/callback                        (local dev)
#   https://server-sooty-rho.vercel.app/api/google-calendar/callback          (production backend)
# The redirect URI must point at the BACKEND host (Vercel), not the ckript.com front-end.
# Then set this var per-environment to the one that matches that deployment:
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5002/api/google-calendar/callback
# 64 hex chars (32 bytes) — encrypts Google refresh tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENC_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dedicated secret for scoped, short-lived file attachment JWTs (minimum 32 random bytes).
# Generate independently from JWT_SECRET so authentication and upload grants have separate keys.
FILE_UPLOAD_GRANT_SECRET=
# Optional comma-separated public DNS hostnames in addition to the built-in Cloudinary hosts.
TRUSTED_MEDIA_HOSTS=
# ── Outgoing mail ────────────────────────────────────────────────────────────
# EMAIL_USER / EMAIL_PASSWORD are the SMTP LOGIN — the mailbox that authenticates.
# EMAIL_FROM_ADDRESS / EMAIL_FROM_NAME are what RECIPIENTS see. They are separate
# on purpose: the login is whatever the provider issued, the From is the company.
# Blank From falls back to COMPANY_EMAIL, so recipients see CKRIPT <info@ckript.com>.
# EMAIL_USER is NOT used as a fallback for the From — that is what leaked the
# gmail login address into users' inboxes.
#
# Leave EMAIL_HOST and EMAIL_PORT blank to fall back to Gmail (development).
# Set all three to use any other provider:
#   port 587 -> EMAIL_SECURE=false (STARTTLS)     port 465 -> EMAIL_SECURE=true
# Mismatching the port and the flag hangs the connection instead of erroring.
#
# Note: ckript.com's MX points at Cloudflare Email Routing, which RECEIVES only —
# there is no ckript.com SMTP server to log in to. Setting EMAIL_USER=info@ckript.com
# does NOT work: Gmail rejects it with EAUTH 535 because it is not a Google login.
# To send AS info@ckript.com, either verify it as a "send mail as" alias on the
# Gmail account and keep the gmail address as EMAIL_USER, or use a transactional
# provider and verify the domain there.
#
#   Gmail alias:  EMAIL_USER=<the-gmail-login>  EMAIL_FROM_ADDRESS=info@ckript.com
#   Provider:     EMAIL_USER=<api-user>  EMAIL_PASSWORD=<api-key>  EMAIL_FROM_ADDRESS=info@ckript.com
#
# Gmail requires an APP PASSWORD (2-Step Verification on), never the account password.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=info@ckript.com
EMAIL_FROM_NAME=CKRIPT
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=

# ── Public-facing addresses ──────────────────────────────────────────────────
# Shown to users in email footers, invoices, certificates and on the site. Split
# by ROLE so each enquiry reaches the desk staffed for it. Defaults live in
# server/utils/companyContacts.js; set these only to redirect a role.
COMPANY_EMAIL=info@ckript.com
SUPPORT_EMAIL=support@ckript.com
CONTACT_EMAIL=contact@ckript.com
COMPANY_WEBSITE=https://ckript.com
# Where internal admin/workflow alerts are posted. Defaults to COMPANY_EMAIL.
COMPANY_NOTIFICATION_EMAIL=
ADMIN_RUNTIME_BRANCH=
ADMIN_ALLOWED_BRANCHES=
IP_API_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
GROQ_API_KEY=

# Admin Panel Password
ADMIN_PANEL_CODE=
